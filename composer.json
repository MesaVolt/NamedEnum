{
    "name": "mesavolt/named-enum",
    "description": "Named enums for PHP 8.5+",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "MesaVolt",
            "email": "contact@mesavolt.com"
        }
    ],
    "autoload" : {
        "psr-4" : {
            "Mesavolt\\" : "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mesavolt\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": ">=8.5",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4.7",
        "rector/rector": "^2.8",
        "twig/twig": "^3.21"
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "rector": "@php vendor/bin/rector process",
        "rector:check": "@php vendor/bin/rector process --dry-run"
    }
}
